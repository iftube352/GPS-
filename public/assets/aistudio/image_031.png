<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 800" width="800" height="800">
  <defs>
    <linearGradient id="flameGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#ef4444" />
      <stop offset="45%" stop-color="#f59e0b" />
      <stop offset="100%" stop-color="#fde047" />
    </linearGradient>
    <path id="ribbonTextArc" d="M 155 645 Q 400 765 645 645" />
  </defs>

  <!-- 1. Top Blue Crescent & Star (#0277BD) -->
  <g fill="none" stroke="#0277BD" stroke-width="5.5" stroke-linejoin="round">
    <!-- 5-pointed star -->
    <polygon points="380,45 385,58 399,58 388,66 392,79 380,71 368,79 372,66 361,58 375,58" fill="#ffffff" />
    <!-- Crescent moon -->
    <path d="M 416 44 C 452 62, 456 116, 418 136 C 386 152, 352 132, 350 98 C 364 124, 398 132, 418 114 C 436 96, 434 64, 416 44 Z" fill="#ffffff" />
  </g>

  <!-- 2. Left & Right Blue Laurel / Olive Branches (#0277BD) -->
  <g fill="#ffffff" stroke="#0277BD" stroke-width="6" stroke-linecap="round" stroke-linejoin="round">
    <!-- Left stem -->
    <path d="M 206 525 C 145 380, 165 215, 295 125" fill="none" />
    <!-- Left outer leaves -->
    <path d="M 275 140 C 260 112, 285 98, 305 118 C 292 134, 280 140, 275 140 Z" />
    <path d="M 242 168 C 218 148, 224 120, 250 132 C 254 150, 246 164, 242 168 Z" />
    <path d="M 210 212 C 180 196, 182 164, 212 174 C 218 192, 212 206, 210 212 Z" />
    <path d="M 186 264 C 152 252, 148 218, 182 224 C 190 242, 188 258, 186 264 Z" />
    <path d="M 174 322 C 138 314, 132 280, 166 282 C 176 300, 174 316, 174 322 Z" />
    <path d="M 172 384 C 136 378, 128 344, 162 344 C 174 362, 172 378, 172 384 Z" />
    <path d="M 180 442 C 144 438, 136 404, 170 404 C 182 420, 180 436, 180 442 Z" />
    <path d="M 196 498 C 160 496, 152 462, 186 460 C 198 476, 196 492, 196 498 Z" />
    <!-- Left inner leaves -->
    <path d="M 262 152 C 286 144, 308 158, 288 176 C 272 172, 264 158, 262 152 Z" />
    <path d="M 226 190 C 254 182, 274 200, 252 218 C 234 212, 228 196, 226 190 Z" />
    <path d="M 196 242 C 224 236, 246 256, 220 272 C 204 266, 198 248, 196 242 Z" />
    <path d="M 180 300 C 210 294, 230 318, 204 334 C 188 326, 182 308, 180 300 Z" />
    <path d="M 174 360 C 204 356, 224 380, 198 396 C 182 388, 176 368, 174 360 Z" />
    <path d="M 180 420 C 210 416, 228 442, 202 456 C 186 448, 182 428, 180 420 Z" />
    <path d="M 196 476 C 224 472, 240 498, 214 514 C 200 504, 196 484, 196 476 Z" />

    <!-- Right stem -->
    <path d="M 594 525 C 655 380, 635 215, 505 125" fill="none" />
    <!-- Right outer leaves -->
    <path d="M 525 140 C 540 112, 515 98, 495 118 C 508 134, 520 140, 525 140 Z" />
    <path d="M 558 168 C 582 148, 576 120, 550 132 C 546 150, 554 164, 558 168 Z" />
    <path d="M 590 212 C 620 196, 618 164, 588 174 C 582 192, 588 206, 590 212 Z" />
    <path d="M 614 264 C 648 252, 652 218, 618 224 C 610 242, 612 258, 614 264 Z" />
    <path d="M 626 322 C 662 314, 668 280, 634 282 C 624 300, 626 316, 626 322 Z" />
    <path d="M 628 384 C 664 378, 672 344, 638 344 C 626 362, 628 378, 628 384 Z" />
    <path d="M 620 442 C 656 438, 664 404, 630 404 C 618 420, 620 436, 620 442 Z" />
    <path d="M 604 498 C 640 496, 648 462, 614 460 C 602 476, 604 492, 604 498 Z" />
    <!-- Right inner leaves -->
    <path d="M 538 152 C 514 144, 492 158, 512 176 C 528 172, 536 158, 538 152 Z" />
    <path d="M 574 190 C 546 182, 526 200, 548 218 C 566 212, 572 196, 574 190 Z" />
    <path d="M 604 242 C 576 236, 554 256, 580 272 C 596 266, 602 248, 604 242 Z" />
    <path d="M 620 300 C 590 294, 570 318, 596 334 C 612 326, 618 308, 620 300 Z" />
    <path d="M 626 360 C 596 356, 576 380, 602 396 C 618 388, 624 368, 626 360 Z" />
    <path d="M 620 420 C 590 416, 572 442, 598 456 C 614 448, 618 428, 620 420 Z" />
    <path d="M 604 476 C 576 472, 560 498, 586 514 C 600 504, 604 484, 604 476 Z" />
  </g>

  <!-- 3. Center Candle, Flame & Light Rays -->
  <!-- Radiating Black Light Rays -->
  <g stroke="#111827" stroke-width="4" stroke-linecap="round">
    <line x1="394" y1="248" x2="390" y2="206" />
    <line x1="378" y1="252" x2="360" y2="212" />
    <line x1="364" y1="262" x2="332" y2="232" />
    <line x1="352" y1="274" x2="314" y2="252" />
    <line x1="346" y1="288" x2="306" y2="282" />
    <line x1="350" y1="304" x2="312" y2="310" />
    <line x1="358" y1="318" x2="326" y2="338" />
    <line x1="366" y1="328" x2="342" y2="356" />
    <line x1="408" y1="250" x2="424" y2="210" />
    <line x1="422" y1="260" x2="452" y2="228" />
    <line x1="432" y1="272" x2="472" y2="250" />
    <line x1="438" y1="284" x2="480" y2="274" />
    <line x1="438" y1="298" x2="476" y2="306" />
    <line x1="432" y1="312" x2="466" y2="330" />
    <line x1="424" y1="324" x2="452" y2="352" />
  </g>

  <!-- Candle Flame -->
  <path d="M 392 322 C 368 320, 372 286, 386 272 C 390 264, 386 256, 384 256 C 402 262, 418 288, 412 310 C 408 320, 400 322, 392 322 Z" fill="url(#flameGrad)" stroke="#b45309" stroke-width="2.5" />
  <ellipse cx="394" cy="308" rx="6" ry="10" fill="#fef08a" stroke="#475569" stroke-width="1.5" />

  <!-- Candle Body (#00A651) -->
  <path d="M 372 344 L 372 414 L 414 414 L 414 334 Z" fill="#ffffff" stroke="#00A651" stroke-width="6.5" stroke-linejoin="round" />
  <ellipse cx="393" cy="340" rx="21" ry="10" fill="#bbf7d0" stroke="#00A651" stroke-width="5" />
  <line x1="393" y1="322" x2="393" y2="338" stroke="#00A651" stroke-width="5" stroke-linecap="round" />

  <!-- 4. Green Open Book (#00A651) -->
  <g fill="#ffffff" stroke="#00A651" stroke-width="6.5" stroke-linecap="round" stroke-linejoin="round">
    <!-- Outer Back Cover -->
    <path d="M 284 412 L 226 562 L 368 594 L 368 608 L 424 608 L 424 594 L 574 562 L 502 406" />
    <!-- Middle Page Layer -->
    <path d="M 300 404 L 244 548 L 396 592 L 552 544 L 486 398" />
    <!-- Top Open Pages -->
    <path d="M 396 416 C 368 394, 336 390, 316 392 L 262 532 C 306 534, 356 552, 396 588 Z" />
    <path d="M 396 416 C 422 396, 448 386, 468 384 L 534 528 C 488 532, 438 552, 396 588 Z" />
    <!-- Center Spine Line -->
    <line x1="396" y1="416" x2="396" y2="592" stroke-width="6.5" />
  </g>

  <!-- Curved Page Lines inside Open Book (#00A651) -->
  <g fill="none" stroke="#00A651" stroke-width="3.8" stroke-linecap="round">
    <!-- Left Page Lines -->
    <path d="M 314 416 C 344 412, 372 422, 394 440" />
    <path d="M 306 438 C 338 434, 368 444, 394 464" />
    <path d="M 296 462 C 330 458, 364 468, 394 490" />
    <path d="M 288 486 C 324 482, 360 492, 394 516" />
    <path d="M 278 510 C 316 506, 356 518, 394 544" />
    <!-- Right Page Lines -->
    <path d="M 398 440 C 420 420, 448 408, 474 406" />
    <path d="M 398 464 C 424 442, 454 430, 484 428" />
    <path d="M 398 490 C 428 468, 462 454, 494 452" />
    <path d="M 398 516 C 432 492, 470 478, 504 476" />
    <path d="M 398 544 C 436 518, 478 502, 514 500" />
  </g>

  <!-- 5. Bottom Magenta-Pink Ribbon Banner (#FF0055) -->
  <g fill="#ffffff" stroke="#FF0055" stroke-width="7.5" stroke-linecap="round" stroke-linejoin="round">
    <!-- Left Ribbon Tail -->
    <path d="M 232 586 L 86 478 L 84 540 L 28 546 L 146 644 L 214 624 Z" />
    <!-- Right Ribbon Tail -->
    <path d="M 572 586 L 716 478 L 718 540 L 774 546 L 656 644 L 588 624 Z" />
    <!-- Ribbon Folds -->
    <path d="M 168 584 L 234 586 L 218 624" fill="#ffe4ef" />
    <path d="M 636 584 L 570 586 L 586 624" fill="#ffe4ef" />
    <!-- Main Curved Banner -->
    <path d="M 168 584 Q 400 712 636 584 L 676 668 Q 400 822 128 668 Z" fill="#ffffff" />
  </g>

  <!-- Left & Right Magenta-Pink 5-Pointed Stars -->
  <polygon points="118,544 124,560 140,560 127,570 132,586 118,576 104,586 109,570 96,560 112,560" fill="#FF0055" />
  <polygon points="686,544 692,560 708,560 695,570 700,586 686,576 672,586 677,570 664,560 680,560" fill="#FF0055" />

  <!-- Curved Banner Text: GPS CHAMBAI KOHAT -->
  <text fill="#FF0055" font-family="'Plus Jakarta Sans', Arial, sans-serif" font-size="45" font-weight="900" letter-spacing="3">
    <textPath href="#ribbonTextArc" startOffset="50%" text-anchor="middle">
      GPS CHAMBAI KOHAT
    </textPath>
  </text>
</svg>
